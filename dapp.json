{
  "description": "A football management game: name your manager, buy a Division 3 club with dummy USDC (a mockup, no real payment), set your lineup and tactics, sign and sell players on a transfer market, and play 34-matchday seasons in a three-tier league of 162 clubs with promotion and relegation.",
  "category": "other",
  "icon": {
    "emoji": "\u26bd"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "New career screen",
      "path": "/",
      "expectText": "New career"
    },
    {
      "name": "New career shows the club shop",
      "path": "/",
      "expectText": "Dummy USDC (staging mock)"
    },
    {
      "name": "New career lists every division at its tier price",
